# GramSeva Environment Configuration
# Copy this file to .env and fill in your values

# Database — PostgreSQL + PostGIS
DATABASE_URL=postgresql://gramseva:gramseva@localhost:5432/gramseva

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AI/ML Models (optional)
# SEGFORMER_MODEL_PATH=./models/segformer-b2
# SIAMESE_MODEL_PATH=./models/siamese-resnet50
# SBERT_MODEL_NAME=all-MiniLM-L6-v2
# CHANGEFORMER_MODEL_PATH=./models/changeformer

# File Storage
UPLOAD_DIR=../data/uploads
PROCESSED_DIR=../data/processed

# Demo Mode
DEMO_MODE=true
